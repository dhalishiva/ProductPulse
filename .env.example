# Server-side only. Set these in Vercel -> Project Settings -> Environment Variables
# (Production, and Preview if you want preview deployments to show live data).
# Never prefix with VITE_ — that would expose them to the browser.

# Vercel access token with access to your team (Account Settings -> Tokens).
VERCEL_TOKEN=
# Your Vercel team id (Team Settings -> General), e.g. team_xxxxxxxx
VERCEL_TEAM_ID=
# Passcode that unlocks /app/traffic. Use a long, unique phrase (16+ characters).
PRODUCTPULSE_PASSCODE=
# Random secret used to sign the session cookie, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Optional. Days of analytics history your Vercel plan serves. Defaults to 31 (Hobby).
# Raise it if you upgrade, so longer ranges and period comparisons work.
# VERCEL_ANALYTICS_HISTORY_DAYS=31
